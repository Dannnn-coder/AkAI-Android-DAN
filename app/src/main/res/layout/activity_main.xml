<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#1E1E1E">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AkAI v1.7"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#263238"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Help"/>

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#263238"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Camera Feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:background="#000000"/>

    <!-- Current Prediction Badge -->
    <TextView
        android:id="@+id/tvPrediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show your hands..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#1E1E1E"
        android:gravity="center"/>

    <!-- Top 3 Predictions Panel — visible when confidence is medium -->
    <LinearLayout
        android:id="@+id/top3Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Did you mean?"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/btnDismissTop3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="16sp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Choice 1 -->
            <LinearLayout
                android:id="@+id/btnChoice1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1A237E"
                android:padding="10dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvChoice1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvConf1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#90CAF9"
                    android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Choice 2 -->
            <LinearLayout
                android:id="@+id/btnChoice2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#263238"
                android:padding="10dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvChoice2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvConf2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#90CAF9"
                    android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Choice 3 -->
            <LinearLayout
                android:id="@+id/btnChoice3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#263238"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvChoice3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvConf3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#90CAF9"
                    android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Letter Buffer Panel — visible only during fingerspelling -->
    <LinearLayout
        android:id="@+id/letterBufferPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#1A237E"
        android:visibility="gone">

        <!-- Letter chips container -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/letterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"/>

        </HorizontalScrollView>

        <!-- Confirm button -->
        <TextView
            android:id="@+id/btnConfirmWord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:background="#2E7D32"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Delete button -->
        <TextView
            android:id="@+id/btnDeleteWord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✗"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:background="#B71C1C"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Conversation Thread -->
    <ScrollView
        android:id="@+id/scrollConversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:padding="8dp"
        android:background="#121212">

        <LinearLayout
            android:id="@+id/conversationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"/>

    </ScrollView>

    <!-- Deaf Sentence Builder -->
    <LinearLayout
        android:id="@+id/sentenceBuilderPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#1E1E1E">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvSentenceDraft"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="140dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/sentence_builder_empty"
                android:textColor="#BDBDBD"
                android:textSize="15sp"
                android:background="#263238" />

        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnFingerspell"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Fingerspell"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#3949AB"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSendSentence"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#2E7D32"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Mode Switcher Panel -->
    <LinearLayout
        android:id="@+id/modeSwitcherPanel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal">

        <!-- FSL Camera Button -->
        <LinearLayout
            android:id="@+id/btnFSLMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A237E"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/tvFSLStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FSL Camera — Active"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Speech Input Button -->
        <LinearLayout
            android:id="@+id/btnSpeechMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1B5E20"
            android:clickable="true"
            android:focusable="true">

            <!-- Language Toggle -->
            <TextView
                android:id="@+id/tvLanguageToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇵🇭 Filipino"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:background="#2E7D32"
                android:padding="4dp"
                android:layout_marginBottom="2dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/tvSpeechStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speech Input — Dormant"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
