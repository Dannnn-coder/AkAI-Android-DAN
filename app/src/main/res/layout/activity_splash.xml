<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: white full-screen frame. The composition owns the ENTIRE available
     height (match_parent + gravity center), so the logo/name group can shift up
     and the tagline can appear below it without anything being cut. Clipping is
     disabled on BOTH relevant containers (the root frame and the composition
     itself) so the 26dp upward movement can never chop the top of the logo/name
     group on short screens or at large font scales. No hardcoded heights — the
     layout adapts to any screen size. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The composition fills the screen and centers its content vertically +
         horizontally. Being the full height means the animated states always
         have room: [logo + AkAI] and, after the shift, [logo + AkAI + tagline]. -->
    <LinearLayout
        android:id="@+id/splashCenter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/akai_logo"
            android:scaleType="centerCrop"
            android:contentDescription="AkAI Logo"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/akai_blue"
            android:textSize="44sp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_tagline"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:alpha="0" />

    </LinearLayout>

</FrameLayout>