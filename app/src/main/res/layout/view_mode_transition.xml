<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen Camera <-> Voice mode transition panel (drawn LAST in the decor
     view so it sits on top of everything). The root slides vertically; the
     title + custom progress bar sit at the visual center and fade/slide in
     subtly once the panel has arrived. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/akai_blue"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/transitionContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvTransitionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:textColor="@color/white"
            android:textSize="21sp" />

        <com.akai.ui.ModeTransitionBar
            android:id="@+id/transitionBar"
            android:layout_width="240dp"
            android:layout_height="20dp"
            android:layout_marginTop="24dp" />
    </LinearLayout>

</FrameLayout>