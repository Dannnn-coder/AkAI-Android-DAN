<?xml version="1.0" encoding="utf-8"?>
<!-- Small white 3D button for the Dual Device Host/Join pages (Cancel / Join).
     Same thick ~12dp solid depth as the page's big buttons (bg_white_3d_dual_device)
     but with gentler 14dp corners suited to a compact button. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/akai_white_shadow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/akai_white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>