<?xml version="1.0" encoding="utf-8"?>
<!-- Unified Camera / Voice switch housing: a single FLAT themed pill with a blue
     outline. Only the selected segment carries the raised 3D depth. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/theme_modeswitch_bg" />
    <corners android:radius="28dp" />
    <stroke
        android:width="2dp"
        android:color="@color/akai_blue" />
</shape>
