<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent system-splash icon.

     The launcher/application icon is intentionally NOT shown on the Android
     12+ (and AndroidX compatibility) system splash. This blank drawable keeps
     the system launch surface pure white so the AkAI branded logo is the ONLY
     thing the user ever sees. The launcher icon itself is untouched. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h48v48h-48z" />
</vector>