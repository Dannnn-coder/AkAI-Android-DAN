<?xml version="1.0" encoding="utf-8"?>
<!-- Circular 3D-style white button: main top layer over a light-blue bottom/shadow
     layer. Used for the Reset Conversation button on the blue Voice-mode area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/akai_white_shadow" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/akai_white" />
        </shape>
    </item>
</layer-list>